PORT=3000
# Clave con la que se firman y verifican los JWT (3.2). En un proyecto real:
# un valor largo y aleatorio, distinto por ambiente, nunca commiteado.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Vencimiento del access token (corto: el refresh dura 7 días y renueva el
# access). Para la demo de token vencido: 10s
JWT_EXPIRES_IN=15m

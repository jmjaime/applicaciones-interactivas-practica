{
  "name": "ejercicios",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate ./src/migrations/Migration -d ./src/db/cli-data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./src/db/cli-data-source.ts",
    "seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.1.0",
    "reflect-metadata": "^0.1.13",
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}

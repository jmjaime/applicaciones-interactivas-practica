{
  "name": "typeorm-ejemplos",
  "version": "1.0.0",
  "description": "Ejemplos prácticos de TypeORM para la Clase 4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf --glob dist \"*.sqlite\"",
    "entidades": "ts-node src/01-entidades/example.ts",
    "restricciones": "ts-node src/02-restricciones/example.ts",
    "validacion": "ts-node src/03-validacion/example.ts",
    "relaciones": "ts-node src/04-relaciones/example.ts",
    "carga": "ts-node src/05-carga/example.ts",
    "carga:lazy": "ts-node src/05-carga/lazy-relations-example.ts",
    "embebidos": "ts-node src/06-embebidos/example.ts",
    "herencia": "ts-node src/07-herencia/example.ts",
    "herencia:tph": "ts-node src/07-herencia/table-per-hierarchy/example.ts",
    "herencia:tpc": "ts-node src/07-herencia/table-per-class/example.ts",
    "query-builder": "ts-node src/08-query-builder/example.ts",
    "optimizacion": "ts-node src/09-optimizacion/example.ts",
    "migraciones": "ts-node src/10-migraciones/example.ts",
    "migraciones:fk": "ts-node src/10-migraciones/foreign-key-example.ts",
    "transacciones": "ts-node src/11-transacciones/example.ts"
  },
  "keywords": [
    "typeorm",
    "orm",
    "typescript",
    "database",
    "examples"
  ],
  "author": "UADE - Aplicaciones Interactivas",
  "license": "MIT",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/sql.js": "^1.4.9",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
